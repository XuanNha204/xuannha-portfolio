# Database
MONGODB_URI=mongodb://127.0.0.1:27017/xuannha-dev

# Authentication
AUTH_SECRET=your-random-secret-at-least-32-chars
AUTH_TRUST_HOST=true

# Public URL for metadata and sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial owner account (npm run seed)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-password
ADMIN_NAME=Your Name

# Optional performance diagnostics
PERFORMANCE_LOGGING=0
PERFORMANCE_SLOW_MS=250

# Optional AI (server only; compatible streaming endpoint)
CHAT_PROVIDER_ORDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gmail contact notifications (server only)
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=
CONTACT_NOTIFICATION_EMAIL=your-account@gmail.com
