@{
    ViewData["Title"] = "Vibe Coding Studio";
}

<section class="hero-minimal" aria-labelledby="hero-title">
    <div class="container-xl hero-content">
        <p class="eyebrow">Portfolio CMS / ASP.NET Core / AI-assisted builds</p>
        <h1 id="hero-title">XuanNha.Dev</h1>
        <p class="hero-lead">
            A dark-tech portfolio and CMS studio for shipping clean web products,
            technical writing, and project stories with production-minded architecture.
        </p>
        <div class="hero-actions">
            <a class="btn-primary-neo" href="#projects">View Work</a>
            <a class="btn-ghost-neo" href="#studio">Explore Studio</a>
        </div>
        <div class="hero-metrics" aria-label="Studio focus">
            <div>
                <strong>10.0</strong>
                <span>.NET Core</span>
            </div>
            <div>
                <strong>CMS</strong>
                <span>Code First</span>
            </div>
            <div>
                <strong>3D</strong>
                <span>Interactive UI</span>
            </div>
        </div>
    </div>
</section>

<section id="projects" class="content-band project-band">
    <div class="container-xl">
        <div class="section-kicker">Selected direction</div>
        <div class="section-heading-row">
            <h2>Builds with structure, motion, and a real backend.</h2>
            <p>
                The platform is growing from portfolio into CMS: projects, blog posts,
                media, profile content, and admin workflows backed by SQL Server.
            </p>
        </div>
        <div class="work-grid">
            <article class="work-card">
                <span>01</span>
                <h3>Portfolio CMS</h3>
                <p>Project showcases, dynamic profile content, media galleries, and SEO-ready publishing.</p>
            </article>
            <article class="work-card">
                <span>02</span>
                <h3>Technical Blog</h3>
                <p>Markdown-first writing with categories, tags, reading time, and related content paths.</p>
            </article>
            <article class="work-card">
                <span>03</span>
                <h3>Admin Studio</h3>
                <p>Focused dashboards for content operations, uploads, stats, and structured site settings.</p>
            </article>
        </div>
    </div>
</section>

<section id="studio" class="content-band studio-band">
    <div class="container-xl studio-layout">
        <div>
            <div class="section-kicker">Vibe Coding Studio</div>
            <h2>Design systems, database-first thinking, and motion that serves the product.</h2>
        </div>
        <div class="capability-list">
            <div>
                <strong>ASP.NET Core MVC</strong>
                <span>Razor views, clean controllers, service layer, repository layer.</span>
            </div>
            <div>
                <strong>Entity Framework Core</strong>
                <span>Code First migrations, relational modeling, indexes, and SQL Server persistence.</span>
            </div>
            <div>
                <strong>Dark Tech UI</strong>
                <span>Calm density, responsive layouts, subtle animation, and readable contrast.</span>
            </div>
        </div>
    </div>
</section>

<section id="contact" class="content-band contact-band">
    <div class="container-xl contact-strip">
        <div>
            <div class="section-kicker">Next iteration</div>
            <h2>Ready for admin workflows and real content.</h2>
        </div>
        <a class="btn-primary-neo" href="mailto:hello@xuannha.dev">Start a Conversation</a>
    </div>
</section>

