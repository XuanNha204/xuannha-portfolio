@model SkillFormViewModel

@{
    ViewData["Title"] = "New Skill";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">About Page</p>
        <h1>New skill</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Skills" asp-action="Index">Back to list</a>
</section>

<form asp-area="Admin" asp-controller="Skills" asp-action="Create" method="post" class="admin-form">
    <partial name="_SkillForm" model="Model" />
    <button type="submit" class="btn-primary-neo">Create Skill</button>
</form>
