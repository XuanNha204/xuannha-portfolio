@model TagFormViewModel

@{
    ViewData["Title"] = "New Tag";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">Taxonomy</p>
        <h1>New tag</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Tags" asp-action="Index">Back to list</a>
</section>

<form asp-area="Admin" asp-controller="Tags" asp-action="Create" method="post" class="admin-form">
    <partial name="_TagForm" model="Model" />
    <button type="submit" class="btn-primary-neo">Create Tag</button>
</form>
