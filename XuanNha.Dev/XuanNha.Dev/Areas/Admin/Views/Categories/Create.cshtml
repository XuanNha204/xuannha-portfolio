@model CategoryFormViewModel

@{
    ViewData["Title"] = "New Category";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">Taxonomy</p>
        <h1>New category</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Categories" asp-action="Index">Back to list</a>
</section>

<form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" class="admin-form">
    <partial name="_CategoryForm" model="Model" />
    <button type="submit" class="btn-primary-neo">Create Category</button>
</form>
