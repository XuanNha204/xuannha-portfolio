@model CategoryFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger admin-validation"></div>

<div class="admin-form-grid">
    <label>
        Name
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </label>

    <label>
        Slug
        <input asp-for="Slug" placeholder="Leave empty to auto-generate" />
        <span asp-validation-for="Slug" class="text-danger"></span>
    </label>

    <label class="span-2">
        Description
        <textarea asp-for="Description" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </label>
</div>
