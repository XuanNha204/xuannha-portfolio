@model BlogDetailDto

@{
    ViewData["Title"] = "Blog Post Details";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">Blog CMS</p>
        <h1>@Model.Title</h1>
    </div>
    <div class="admin-heading-actions">
        <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Blogs" asp-action="Index">Back</a>
        <a class="btn-primary-neo" asp-area="Admin" asp-controller="Blogs" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
    </div>
</section>

@if (TempData["AdminSuccess"] is string message)
{
    <div class="admin-alert">@message</div>
}

<section class="admin-detail-grid">
    <div>
        <span>Slug</span>
        <strong>@Model.Slug</strong>
    </div>
    <div>
        <span>Status</span>
        <strong>@Model.Status</strong>
    </div>
    <div>
        <span>Reading Time</span>
        <strong>@Model.ReadingTimeMinutes min</strong>
    </div>
    <div>
        <span>Published</span>
        <strong>@(Model.PublishedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</strong>
    </div>
</section>

<section class="admin-read-panel">
    <h2>Summary</h2>
    <p>@Model.Summary</p>
    <h2>Rendered Preview</h2>
    <article class="markdown-preview">
        @Html.Raw(Model.ContentHtml)
    </article>
    <h2>Markdown Source</h2>
    <pre class="markdown-source">@Model.ContentMarkdown</pre>
</section>
