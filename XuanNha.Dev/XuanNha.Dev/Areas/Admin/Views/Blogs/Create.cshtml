@model BlogFormViewModel

@{
    ViewData["Title"] = "Create Blog Post";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">Blog CMS</p>
        <h1>Create post</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Blogs" asp-action="Index">Back to Blog</a>
</section>

<form asp-area="Admin" asp-controller="Blogs" asp-action="Create" method="post" class="admin-editor-form">
    @Html.AntiForgeryToken()
    <partial name="_BlogForm" model="Model" />
    <div class="admin-form-actions">
        <button type="submit" class="btn-primary-neo">Create Post</button>
        <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Blogs" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
