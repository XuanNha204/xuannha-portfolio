@model ProjectIndexViewModel

@{
    ViewData["Title"] = "Projects";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">Project CMS</p>
        <h1>Projects</h1>
    </div>
    <a class="btn-primary-neo" asp-area="Admin" asp-controller="Projects" asp-action="Create">New Project</a>
</section>

@if (TempData["AdminSuccess"] is string message)
{
    <div class="admin-alert">@message</div>
}

<form asp-area="Admin" asp-controller="Projects" asp-action="Index" method="get" class="admin-filter-bar">
    <input asp-for="Query.Search" name="Search" placeholder="Search title, summary, stack" />
    <select asp-for="Query.Status" name="Status" asp-items="Html.GetEnumSelectList<ProjectStatus>()">
        <option value="">All statuses</option>
    </select>
    <select asp-for="Query.Featured" name="Featured">
        <option value="">All projects</option>
        <option value="true">Featured only</option>
        <option value="false">Not featured</option>
    </select>
    <select asp-for="Query.SortBy" name="SortBy">
        <option value="">Created</option>
        <option value="title">Title</option>
        <option value="publishedat">Published date</option>
        <option value="featured">Featured</option>
    </select>
    <input type="hidden" name="Descending" value="true" />
    <button type="submit" class="btn-ghost-neo">Filter</button>
</form>

<section class="admin-table-wrap">
    @if (!Model.Projects.Items.Any())
    {
        <div class="admin-empty-state">
            <p class="section-kicker">No projects yet</p>
            <h1>Create the first project showcase.</h1>
            <a class="btn-primary-neo" asp-area="Admin" asp-controller="Projects" asp-action="Create">Create Project</a>
        </div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Project</th>
                    <th>Status</th>
                    <th>Featured</th>
                    <th>Published</th>
                    <th class="admin-table-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model.Projects.Items)
                {
                    <tr>
                        <td>
                            <strong>@project.Title</strong>
                            <span>@project.Slug</span>
                        </td>
                        <td><span class="admin-pill">@project.Status</span></td>
                        <td>@(project.Featured ? "Yes" : "No")</td>
                        <td>@(project.PublishedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="admin-row-actions">
                            <a asp-area="Admin" asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">View</a>
                            <a asp-area="Admin" asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id">Edit</a>
                            <form asp-area="Admin" asp-controller="Projects" asp-action="ToggleFeatured" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@project.Id" />
                                <input type="hidden" name="featured" value="@(!project.Featured)" />
                                <button type="submit">@(project.Featured ? "Unfeature" : "Feature")</button>
                            </form>
                            <a class="danger-link" asp-area="Admin" asp-controller="Projects" asp-action="Delete" asp-route-id="@project.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="admin-pagination">
            <span>Page @Model.Projects.PageNumber of @Model.Projects.TotalPages</span>
            <div>
                @if (Model.Projects.HasPreviousPage)
                {
                    <a asp-area="Admin" asp-controller="Projects" asp-action="Index"
                       asp-route-Search="@Model.Query.Search"
                       asp-route-Status="@Model.Query.Status"
                       asp-route-Featured="@Model.Query.Featured"
                       asp-route-SortBy="@Model.Query.SortBy"
                       asp-route-Descending="@Model.Query.Descending"
                       asp-route-PageNumber="@(Model.Projects.PageNumber - 1)"
                       asp-route-PageSize="@Model.Projects.PageSize">Previous</a>
                }
                @if (Model.Projects.HasNextPage)
                {
                    <a asp-area="Admin" asp-controller="Projects" asp-action="Index"
                       asp-route-Search="@Model.Query.Search"
                       asp-route-Status="@Model.Query.Status"
                       asp-route-Featured="@Model.Query.Featured"
                       asp-route-SortBy="@Model.Query.SortBy"
                       asp-route-Descending="@Model.Query.Descending"
                       asp-route-PageNumber="@(Model.Projects.PageNumber + 1)"
                       asp-route-PageSize="@Model.Projects.PageSize">Next</a>
                }
            </div>
        </div>
    }
</section>
