@model ProjectFormViewModel

@{
    ViewData["Title"] = "Create Project";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">Project CMS</p>
        <h1>Create project</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Projects" asp-action="Index">Back to Projects</a>
</section>

<form asp-area="Admin" asp-controller="Projects" asp-action="Create" method="post" class="admin-editor-form">
    @Html.AntiForgeryToken()
    <partial name="_ProjectForm" model="Model" />
    <div class="admin-form-actions">
        <button type="submit" class="btn-primary-neo">Create Project</button>
        <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Projects" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
