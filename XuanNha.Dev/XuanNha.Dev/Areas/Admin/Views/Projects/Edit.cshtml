@model ProjectFormViewModel

@{
    ViewData["Title"] = "Edit Project";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">Project CMS</p>
        <h1>Edit project</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Projects" asp-action="Details" asp-route-id="@Model.Id">View Project</a>
</section>

<form asp-area="Admin" asp-controller="Projects" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-editor-form">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <partial name="_ProjectForm" model="Model" />
    <div class="admin-form-actions">
        <button type="submit" class="btn-primary-neo">Save Changes</button>
        <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Projects" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
