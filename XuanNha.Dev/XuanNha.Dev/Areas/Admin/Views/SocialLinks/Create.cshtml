@model SocialLinkFormViewModel

@{
    ViewData["Title"] = "New Social Link";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">About Page</p>
        <h1>New social link</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="SocialLinks" asp-action="Index">Back to list</a>
</section>

<form asp-area="Admin" asp-controller="SocialLinks" asp-action="Create" method="post" class="admin-form">
    <partial name="_SocialLinkForm" model="Model" />
    <button type="submit" class="btn-primary-neo">Create Link</button>
</form>
