@model List<XuanNha.Dev.Entities.Profile.Certificate>

@{
    ViewData["Title"] = "Certificates";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">About Page</p>
        <h1>Certificates</h1>
    </div>
    <a class="btn-primary-neo" asp-area="Admin" asp-controller="Certificates" asp-action="Create">New Certificate</a>
</section>

@if (TempData["AdminSuccess"] is string message)
{
    <div class="admin-alert">@message</div>
}

<section class="admin-table-wrap">
    @if (!Model.Any())
    {
        <div class="admin-empty-state">
            <p class="section-kicker">No certificates yet</p>
            <h1>Add the first certificate.</h1>
            <a class="btn-primary-neo" asp-area="Admin" asp-controller="Certificates" asp-action="Create">Create Certificate</a>
        </div>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Certificate</th>
                    <th>Issuer</th>
                    <th>Issued</th>
                    <th class="admin-table-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var certificate in Model)
                {
                    <tr>
                        <td>
                            <strong>@certificate.Name</strong>
                            @if (!string.IsNullOrEmpty(certificate.CredentialUrl))
                            {
                                <span>@certificate.CredentialUrl</span>
                            }
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(certificate.Issuer) ? "-" : certificate.Issuer)</td>
                        <td>@(certificate.IssuedAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="admin-row-actions">
                            <a asp-area="Admin" asp-controller="Certificates" asp-action="Edit" asp-route-id="@certificate.Id">Edit</a>
                            <form asp-area="Admin" asp-controller="Certificates" asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@certificate.Id" />
                                <button type="submit" class="danger-link">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
