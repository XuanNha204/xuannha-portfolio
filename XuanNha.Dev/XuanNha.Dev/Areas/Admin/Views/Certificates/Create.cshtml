@model CertificateFormViewModel

@{
    ViewData["Title"] = "New Certificate";
}

<section class="admin-page-heading">
    <div>
        <p class="section-kicker">About Page</p>
        <h1>New certificate</h1>
    </div>
    <a class="btn-ghost-neo" asp-area="Admin" asp-controller="Certificates" asp-action="Index">Back to list</a>
</section>

<form asp-area="Admin" asp-controller="Certificates" asp-action="Create" method="post" class="admin-form">
    <partial name="_CertificateForm" model="Model" />
    <button type="submit" class="btn-primary-neo">Create Certificate</button>
</form>
