@model ExperienceFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger admin-validation"></div>

<div class="admin-form-grid">
    <label>
        Position
        <input asp-for="Position" />
        <span asp-validation-for="Position" class="text-danger"></span>
    </label>

    <label>
        Company
        <input asp-for="Company" />
        <span asp-validation-for="Company" class="text-danger"></span>
    </label>

    <label>
        Start date
        <input asp-for="StartDate" type="date" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </label>

    <label>
        End date (empty = present)
        <input asp-for="EndDate" type="date" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </label>

    <label class="span-2">
        Description
        <textarea asp-for="Description" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </label>
</div>
